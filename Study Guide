                        <ul className="text-xs text-slate-600 space-y-1 font-medium mt-2 list-disc list-inside"><li>Asymptomatic for 10-20 years</li><li>Chest X-rays may show no changes until symptoms occur</li></ul>
                      </div>
                      <div className="relative">
                        <span className="absolute -left-[37px] top-1 w-4 h-4 bg-white border-4 border-amber-400 rounded-full" />
                        <p className="text-xs font-black text-amber-600 uppercase tracking-wide">Progression</p>
                        <p className="text-sm font-bold text-slate-700 mt-1">Increasing Pathophysiology</p>
                        <ul className="text-xs text-slate-600 space-y-1 font-medium mt-2 list-disc list-inside"><li>Productive cough</li><li>Shortness of breath (worsens with exertion)</li><li>Weakness and Fatigue</li><li><strong>Finger clubbing</strong> (sign of chronic hypoxia)</li></ul>
                      </div>
                      <div className="relative">
                        <span className="absolute -left-[37px] top-1 w-4 h-4 bg-white border-4 border-rose-500 rounded-full" />
                        <p className="text-xs font-black text-rose-600 uppercase tracking-wide">Late Stage</p>
                        <ul className="text-xs text-slate-600 space-y-2 font-medium mt-2 list-disc list-inside"><li>Chronic Hypoxemia</li><li><strong>Cor pulmonale</strong> (Right-sided heart failure due to pressure from fibrosis)</li><li>Respiratory failure</li><li>Chest X-ray findings: <ul className="pl-6 mt-1 space-y-0.5 list-[circle] text-slate-500 italic"><li>Mottling and haziness</li><li>Nodules</li><li>Fibrosis</li><li>Calcifications</li></ul></li></ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </section>
          </div>
        )}

        {activeTab === 'maps' && (
          <div className="space-y-12 animate-in zoom-in-95 duration-500">
             <div className="bg-white p-8 rounded-[2rem] border shadow-sm overflow-hidden text-center">
               <h3 className="text-xl font-black text-slate-800 mb-8 flex items-center justify-center gap-2 uppercase tracking-tighter"><Layers className="text-purple-600" size={24} /> Differentiation: Intrinsic vs. Extrinsic</h3>
              <div className="overflow-x-auto">
                <table className="w-full text-left border-collapse">
                  <thead><tr className="bg-slate-50 border-b-2 border-slate-100"><th className="p-4 text-[10px] font-black uppercase text-slate-400 tracking-widest">Criteria</th><th className="p-4 text-[10px] font-black uppercase text-blue-600 tracking-widest">Extrinsic (Allergic)</th><th className="p-4 text-[10px] font-black uppercase text-purple-600 tracking-widest">Intrinsic (Non-Allergic)</th></tr></thead>
                  <tbody className="text-xs font-bold text-slate-700">
                    <tr className="border-b border-slate-50"><td className="p-4 flex items-center gap-2"><Clock size={14} className="text-slate-400" /> Onset</td><td className="p-4">Childhood / Puberty</td><td className="p-4">Adult ({'>'} 30 years)</td></tr>
                    <tr className="border-b border-slate-50"><td className="p-4 flex items-center gap-2"><Target size={14} className="text-slate-400" /> Triggers</td><td className="p-4 text-blue-700">Pollen, Dander, Dust Mites</td><td className="p-4 text-purple-700">Infections, Cold, Stress, Pollution</td></tr>
                    <tr className="border-b border-slate-50"><td className="p-4 flex items-center gap-2"><Dna size={14} className="text-slate-400" /> Lab/IgE</td><td className="p-4">High IgE levels</td><td className="p-4">Normal IgE levels</td></tr>
                    <tr className="border-b border-slate-50"><td className="p-4 flex items-center gap-2"><Stethoscope size={14} className="text-slate-400" /> Manifestations</td><td className="p-4">The Triad (Asthma/Eczema/Rhinitis)</td><td className="p-4">Severe attacks; no skin tests positive</td></tr>
                    <tr><td className="p-4 flex items-center gap-2"><LineChart size={14} className="text-slate-400" /> Prognosis</td><td className="p-4 bg-blue-50/30 text-blue-700 font-black">Often improves with age</td><td className="p-4 bg-purple-50/30 text-purple-700 font-black">Less favorable; often chronic</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
            <div className="bg-white p-8 rounded-[2rem] border shadow-sm text-center">
              <h3 className="text-xl font-black text-slate-800 mb-8 flex items-center justify-center gap-2 uppercase tracking-tighter"><Users className="text-blue-600" size={24} /> Chain of Transmission</h3>
              <div className="relative space-y-6 flex flex-col items-center">
                {[
                  { label: 'Causative Agent', sub: 'Bacteria, Virus, Fungus', color: 'bg-blue-100 border-blue-400 text-blue-800' },
                  { label: 'Reservoir', sub: 'Human, Soil, Animal', color: 'bg-emerald-100 border-emerald-400 text-emerald-800' },
                  { label: 'Portal of Exit', sub: 'Nasal drops, Oral mucosa', color: 'bg-amber-100 border-amber-400 text-amber-800' },
                  { label: 'Mode of Transmission', sub: 'Direct, Droplet, Vector', color: 'bg-rose-100 border-rose-400 text-rose-800' },
                  { label: 'Portal of Entry', sub: 'Wound, Mucosa, Puncture', color: 'bg-purple-100 border-purple-400 text-purple-800' },
                  { label: 'Susceptible Victim', sub: 'Immunocompromised, Malnourished', color: 'bg-slate-200 border-slate-500 text-slate-900' }
                ].map((step, i, arr) => (
                  <React.Fragment key={step.label}>
                    <div className={`${step.color} border-2 px-6 py-4 rounded-2xl text-center w-full max-w-sm relative z-10 shadow-sm transition-transform hover:scale-105`}>
                      <p className="font-black text-sm uppercase tracking-tight">{step.label}</p>
                      <p className="text-xs font-medium opacity-80">{step.sub}</p>
                    </div>
                    {i < arr.length - 1 && <ChevronRight className="rotate-90 text-slate-300" size={32} />}
                  </React.Fragment>
                ))}
              </div>
            </div>
          </div>
        )}

        {activeTab === 'quiz' && (
          <div className="animate-in fade-in duration-700">
            {!quizStarted ? (
              <div className="bg-white rounded-3xl p-12 text-center border shadow-xl border-blue-100">
                <div className="w-20 h-20 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-6"><Activity size={40} /></div>
                <h2 className="text-3xl font-black text-slate-800 mb-4 tracking-tighter text-center">Oxygenation Mastery Bank</h2>
                <p className="text-slate-500 mb-10 text-lg font-medium italic text-center">50 questions focused on Clinical Mastery of Oxygenation Alterations.</p>
                <div className="flex flex-col sm:flex-row gap-4 justify-center">
                  <button onClick={() => setQuizStarted(true)} className="bg-blue-600 hover:bg-blue-700 text-white font-black px-10 py-5 rounded-2xl transition-all shadow-xl shadow-blue-200 text-lg uppercase tracking-widest active:scale-95">Start Final Mastery Set</button>
                </div>
              </div>
            ) : showResults ? (
              <div className="bg-white rounded-[3rem] shadow-2xl p-12 text-center border animate-in zoom-in-95 duration-500">
                <h2 className="text-5xl font-black text-slate-800 mb-6 tracking-tighter italic">Evaluation Results</h2>
                <div className="text-8xl font-black text-blue-600 mb-6 tracking-tighter">{Math.round((score / quizData.length) * 100)}%</div>
                <p className="text-slate-500 mb-12 text-2xl font-bold">Performance: {score} / {quizData.length}</p>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-lg mx-auto">
                  <button onClick={() => { setCurrentQuestion(0); setScore(0); setShowResults(false); setIsAnswered(false); }} className="flex items-center justify-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-black py-5 rounded-2xl transition-all uppercase tracking-widest"><RefreshCcw size={20} /> Retake</button>
                  <button onClick={downloadPDF} className="flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-black py-5 rounded-2xl transition-all shadow-xl shadow-blue-200 uppercase tracking-widest"><Download size={20} /> Save Study PDF</button>
                </div>
              </div>
            ) : (
              <div className="bg-white rounded-[2.5rem] shadow-xl border border-slate-200 overflow-hidden relative">
                <div className="h-2 bg-slate-100 w-full overflow-hidden">
                  <div className="h-full bg-blue-600 transition-all duration-700 ease-out" style={{ width: `${((currentQuestion + 1) / quizData.length) * 100}%` }} />
                </div>
                <div className="p-10 md:p-14">
                  <span className="text-xs font-black uppercase tracking-[0.2em] text-blue-600 bg-blue-50 px-4 py-2 rounded-full mb-8 inline-block">Scenario {currentQuestion + 1} of {quizData.length}</span>
                  <h3 className="text-2xl md:text-3xl font-black text-slate-800 mb-12 leading-tight text-center md:text-left">{quizData[currentQuestion].question}</h3>
                  <div className="grid gap-4">
                    {quizData[currentQuestion].options ? quizData[currentQuestion].options.map((option, idx) => (
                      <button
                        key={idx}
                        onClick={() => handleOptionClick(idx)}
                        disabled={isAnswered}
                        className={`w-full text-left p-6 rounded-[1.5rem] border-2 transition-all duration-300 flex items-start gap-4 group
                          ${!isAnswered ? 'border-slate-100 hover:border-blue-400 hover:bg-blue-50' : 
                            option.isCorrect ? 'border-emerald-500 bg-emerald-50' : 
                            selectedOption === idx ? 'border-rose-500 bg-rose-50' : 'border-slate-50 opacity-40'}
                        `}
                      >
                        <div className="shrink-0 mt-1">
                          {isAnswered && option.isCorrect ? <CheckCircle2 className="text-emerald-600" size={24} /> :
                           isAnswered && selectedOption === idx ? <XCircle className="text-rose-600" size={24} /> :
                           <div className="w-6 h-6 rounded-full border-2 border-slate-300 group-hover:border-blue-400" />}
                        </div>
                        <span className={`font-bold text-lg ${isAnswered && option.isCorrect ? 'text-emerald-900' : 'text-slate-700'}`}>{option.text}</span>
                      </button>
                    )) : ''}
                  </div>
                  {isAnswered && (
                    <div className="mt-12 animate-in slide-in-from-bottom-6 duration-500">
                      <div className="bg-slate-50 border-l-[6px] border-blue-600 p-8 rounded-3xl mb-10 shadow-inner">
                        <div className="flex items-center gap-2 mb-3"><AlertCircle className="text-blue-600" size={20} /><h4 className="text-sm font-black text-blue-800 uppercase tracking-widest">Clinical Rationale</h4></div>
                        <p className="text-slate-700 text-xl italic font-medium leading-relaxed">{quizData[currentQuestion].options[selectedOption].rationale}</p>
                      </div>
                      <button onClick={nextQuestion} className="w-full bg-slate-900 hover:bg-black text-white font-black py-6 rounded-[2rem] flex justify-center items-center gap-3 transition-all text-xl uppercase tracking-widest shadow-xl">{currentQuestion === quizData.length - 1 ? 'See Results' : 'Next Question'}<ChevronRight size={24} /></button>
                    </div>
                  )}
                </div>
              </div>
            )}
          </div>
        )}
      </main>

      {/* --- EXERCISE-INDUCED MODAL --- */}
      {showExerciseModal && (
        <div className="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-300">
          <div className="bg-white rounded-[2rem] shadow-2xl w-full max-w-2xl overflow-hidden border border-slate-200">
            <div className="bg-blue-600 p-6 flex justify-between items-center text-white">
              <h3 className="text-xl font-black uppercase tracking-tight flex items-center gap-2"><Activity size={24} /> Exercise-Induced Pathophysiology</h3>
              <button onClick={() => setShowExerciseModal(false)} className="hover:bg-blue-700 p-2 rounded-full transition-colors"><X size={24} /></button>
            </div>
            <div className="p-8">
              <div className="space-y-6">
                <div className="flex items-start gap-4">
                  <div className="bg-blue-50 p-4 rounded-2xl border-2 border-blue-100 flex-1">
                    <p className="font-black text-blue-800 text-xs uppercase tracking-widest mb-3 italic underline decoration-blue-200">The Cascade</p>
                    <div className="space-y-4">
                       <div className="flex items-center gap-3">
                         <div className="bg-white p-2 rounded-lg shadow-sm border border-blue-100 text-blue-600 font-black">01</div>
                         <p className="text-sm font-bold text-slate-700">Increased breathing rate (ventilation) occurs during exertion</p>
                       </div>
                       <ArrowDown className="mx-auto text-blue-200" size={16} />
                       <div className="flex items-center gap-3">
                         <div className="bg-white p-2 rounded-lg shadow-sm border border-blue-100 text-blue-600 font-black">02</div>
                         <p className="text-sm font-bold text-slate-700">Significant <strong>heat and water loss</strong> from airway mucosa</p>
                       </div>
                       <ArrowDown className="mx-auto text-blue-200" size={16} />
                       <div className="flex items-center gap-3">
                         <div className="bg-white p-2 rounded-lg shadow-sm border border-blue-100 text-blue-600 font-black">03</div>
                         <p className="text-sm font-bold text-slate-700"><strong>Increase in osmolarity</strong> in the respiratory tract</p>
                       </div>
                       <ArrowDown className="mx-auto text-blue-200" size={16} />
                       <div className="flex items-center gap-3">
                         <div className="bg-rose-50 p-2 rounded-lg shadow-sm border border-rose-100 text-rose-600 font-black">04</div>
                         <p className="text-sm font-black text-rose-800">Trigger: Release of <strong>Mast Cells and Basophils</strong> resulting in bronchoconstriction</p>
                       </div>
                    </div>
                  </div>
                </div>
                <div className="bg-slate-50 p-6 rounded-2xl border border-slate-200 text-center">
                   <p className="text-sm text-slate-600 font-medium leading-relaxed italic">"The rapid ventilation causes mucosal drying and thermal shifts. This increase in osmolarity serves as a potent chemical signal that recruits both mast cells and basophils, leading to severe airway narrowing."</p>
                </div>
                <button onClick={() => setShowExerciseModal(false)} className="w-full bg-slate-900 hover:bg-black text-white font-black py-4 rounded-xl shadow-lg transition-all uppercase tracking-widest text-sm">Return to Guide</button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* --- DRUG-INDUCED MODAL --- */}
      {showDrugModal && (
        <div className="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-300">
          <div className="bg-white rounded-[2rem] shadow-2xl w-full max-w-2xl overflow-hidden border border-slate-200">
            <div className="bg-purple-600 p-6 flex justify-between items-center text-white">
              <h3 className="text-xl font-black uppercase tracking-tight flex items-center gap-2"><Pill size={24} /> Drug-Induced Pathophysiology</h3>
              <button onClick={() => setShowDrugModal(false)} className="hover:bg-purple-700 p-2 rounded-full transition-colors"><X size={24} /></button>
            </div>
            <div className="p-8">
              <div className="space-y-6">
                <div className="flex items-start gap-4">
                  <div className="bg-purple-50 p-6 rounded-2xl border-2 border-purple-100 flex-1">
                    <p className="font-black text-purple-800 text-xs uppercase tracking-widest mb-4 italic underline decoration-purple-200">Mechanism of Action (Aspirin/NSAIDs)</p>
                    <div className="grid gap-6 relative">
                      <div className="bg-white p-4 rounded-xl shadow-sm border border-purple-100 relative z-10">
                        <p className="text-sm font-bold text-slate-700">1. inhibits arachidonic acid conversion to prostaglandins</p>
                      </div>
                      <div className="flex justify-center -my-3"><ArrowDown className="text-purple-300" size={20} /></div>
                      <div className="bg-white p-4 rounded-xl shadow-sm border border-purple-100 relative z-10">
                        <p className="text-sm font-bold text-slate-700">2. arachidonic acid shunted to leukotriene system</p>
                      </div>
                      <div className="flex justify-center -my-3"><ArrowDown className="text-purple-300" size={20} /></div>
                      <div className="bg-rose-50 p-4 rounded-xl shadow-sm border border-rose-100 relative z-10">
                        <p className="text-sm font-black text-rose-800">3. leukotrienes released from mast cells</p>
                      </div>
                    </div>
                  </div>
                </div>
                <div className="bg-slate-50 p-5 rounded-xl border border-slate-200 text-center"><p className="text-xs text-slate-600 font-bold leading-relaxed">Onset: Typically 20 minutes to 3 hours post-ingestion (can be delayed up to 12 hours).</p></div>
                <button onClick={() => setShowDrugModal(false)} className="w-full bg-slate-900 hover:bg-black text-white font-black py-4 rounded-xl shadow-lg transition-all uppercase tracking-widest text-sm">Return to Guide</button>
              </div>
            </div>
          </div>
        </div>
      )}

      <footer className="mt-auto border-t bg-white py-10 px-4 opacity-50">
        <div className="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-right">
          <div className="flex items-center gap-4 text-left">
            <Wind className="text-blue-600" size={40} />
            <div>
              <p className="font-black text-slate-800 uppercase tracking-tighter text-center">Mastery Series</p>
              <p className="text-xs font-bold text-slate-400 uppercase tracking-widest text-center">Unit 4: Pathophysiology I</p>
            </div>
          </div>
          <p className="text-xs font-bold text-slate-400 tracking-tight text-center md:text-right">Galen College of Nursing &copy; 2026 &bull; Exam 2 Focus</p>
        </div>
      </footer>
    </div>
  );
}
